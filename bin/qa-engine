#!/usr/bin/env bash
# qa-engine — operate CLI for qa-engine.lab980.com (the QA engine).
#
# A proxied app site: nginx fronts a pm2-managed gunicorn (Flask + SSE) on
# 127.0.0.1:8044. Bring-up is `provision-site` (see lab980's CLAUDE.md); this
# script owns everything after that:
#
#   qa-engine deploy    fetch+reset -> pip -> npm -> playwright chromium -> pm2 start/restart -> probe -> save
#   qa-engine restart   pm2 restart + probe, no code change
#   qa-engine logs      tail the pm2 logs for this app
#   qa-engine status    HEAD, pm2 state, local + public probe, cert days
#   qa-engine backup    tar the SQLite db + screenshots into data/backups/
#
# Env overrides:
#   QA_ENGINE_FQDN          default qa-engine.lab980.com
#   QA_ENGINE_BRANCH        default main
#   QA_ENGINE_PORT          default 8044 (the probe port; gunicorn's bind is in ecosystem.config.cjs)
#   QA_ENGINE_PROBE_TRIES   default 10 (one second apart)
#
# The app dir is wherever this script's checkout lives (normally
# /var/www/qa-engine) — derived from the script's own path, so the
# /usr/local/bin symlink resolves back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${QA_ENGINE_FQDN:-qa-engine.lab980.com}"
BRANCH="${QA_ENGINE_BRANCH:-main}"
PORT="${QA_ENGINE_PORT:-8044}"
PROBE_TRIES="${QA_ENGINE_PROBE_TRIES:-10}"
APP="qa-engine"

# The `pm2 start` argv that registers this app the FIRST time. Every later
# deploy is a `pm2 restart $APP` of that registration, but on a fresh box (or
# after `pm2 delete`) nothing is registered and restart fails. The registration
# lives in ecosystem.config.cjs: .venv/bin/gunicorn with no interpreter, the
# gthread/--timeout 0 args, fork mode, max_restarts 10, logs in data/. `--only`
# keeps a multi-app file from ever starting anything but $APP. The process gets
# PORT from pm2_clean below (and the ecosystem env block) and nothing else from
# the shell that ran this script.
START_CMD=(ecosystem.config.cjs --only "$APP")

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
qa-engine — operate qa-engine.lab980.com (gunicorn under pm2 behind nginx).

Usage:
  qa-engine deploy               sync, pip, npm, playwright chromium, pm2 start/restart, probe, save
  qa-engine restart              pm2 restart + probe
  qa-engine logs [-n N]          tail pm2 logs
  qa-engine status               HEAD + pm2 + local/public probe + cert
  qa-engine backup               tar data/qa.db + data/screenshots into data/backups/

`redeploy` is accepted as an alias of `deploy`.

Env: QA_ENGINE_FQDN, QA_ENGINE_BRANCH (default main), QA_ENGINE_PORT (default 8044),
     QA_ENGINE_PROBE_TRIES (default 10).
USAGE
}

# The app runs as root under pm2, and pm2 keeps one daemon, process list and
# dump PER HOME — root's is /root/.pm2. Run as anyone else, or as uid 0 with
# someone else's HOME (`su root` without `-`, `sudo` preserving HOME), and
# every pm2 call here talks to a different daemon: `status` says "not
# registered" while the site is up, and `deploy` starts a second copy.
need_root() {
  [ "$(id -u)" -eq 0 ] || die "$1 must run as root (the app's pm2 daemon is root's)."
  local rhome; rhome="$(getent passwd root | cut -d: -f6)"
  [ -n "${PM2_HOME:-}" ] || [ "${HOME:-}" = "$rhome" ] \
    || die "$1: HOME is '${HOME:-}' but root's home is $rhome — pm2 keys its daemon and dump off HOME, so this would talk to a different pm2. Use \`sudo -i\` or \`su -\` (or set PM2_HOME on purpose)."
}

# ---------------------------------------------------------------------------
# pm2. Every pm2 call goes through pm2_clean, which launches it from an EMPTY
# environment plus the handful of variables pm2 itself needs and PORT. pm2
# copies the environment of the `pm2 start` call into the process, and from
# there into ~/.pm2/dump.pm2 on save — so a plain `pm2 start` (or `pm2 restart
# --update-env`, which re-captures the shell on every deploy) from a shell that
# happens to carry a key gives that key an indefinite on-disk lifetime in the
# dump. The daemon itself keeps the environment of whichever call first
# spawned it (visible in its /proc/<pid>/environ for as long as it runs; the
# processes it starts do NOT inherit it), which is why jlist and logs go
# through here as well.
#
# PORT is handed in because provision-site chose it, this script knows it, it
# is not a secret, and an app started from `env -i` would otherwise have no
# port. Everything else the app needs comes from its own `.env` — never from
# the shell that ran this script. A variable the app needs but does not read
# from `.env` is an app change, not an argument to pass here.
# ---------------------------------------------------------------------------
pm2_clean() {
  env -i PATH="$PATH" HOME="$HOME" ${PM2_HOME:+PM2_HOME="$PM2_HOME"} \
    ${TERM:+TERM="$TERM"} LANG=C.UTF-8 PORT="$PORT" pm2 "$@"
}

# `pm2 jlist` is JSON only on a good day: pm2 writes chatter to STDOUT ahead
# of it — `[PM2] Spawning PM2 daemon…` when the daemon was down, `>>>> In-memory
# PM2 is out-of-date` after a pm2 upgrade (node22-bump does one). So the JSON
# is taken from the first line that starts one and parses; anything else is
# reported as unknown (exit 1), never guessed as "not registered" — deploy
# would answer that guess with a second `pm2 start` against a live app.
PM2_JSON='import json, sys
lines = sys.stdin.read().split("\n")
for i, line in enumerate(lines):
    if line[:1] in "[{":
        try:
            procs = json.loads("\n".join(lines[i:]))
        except ValueError:
            continue
        if isinstance(procs, list):
            json.dump(procs, sys.stdout); sys.exit(0)
sys.exit("no parseable JSON in pm2 jlist output")'
pm2_jlist() {   # -> JSON array on stdout; 1 with the reason on stderr
  local jl
  jl="$(pm2_clean jlist 2>/dev/null)" || { echo "pm2 jlist failed" >&2; return 1; }
  printf '%s' "$jl" | python3 -c "$PM2_JSON"
}

# "not registered", "<status>  mode=…", or "unknown (…)" with exit 1.
pm2_state() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf 'unknown (%s)\n' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
p = [x for x in json.load(sys.stdin) if x.get("name") == sys.argv[1]]
if not p: print("not registered"); raise SystemExit
e = p[0].get("pm2_env", {})
print("%s  mode=%s  restarts=%s  uptime-since=%s" % (
  e.get("status"), e.get("exec_mode"), e.get("restart_time"), e.get("pm_uptime")))' "$APP"
}

# Names of registered processes that are not online (empty = all online);
# exit 1 with the reason when the list cannot be read.
pm2_not_online() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf '%s' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
print(" ".join(x.get("name", "?") for x in json.load(sys.stdin)
               if x.get("pm2_env", {}).get("status") != "online"))'
}

save_if_online() {
  # pm2 save overwrites the dump with whatever is running right now, so a save
  # while anything is down persists a dump that comes back short on the next
  # reboot. The box rule (lab980 CLAUDE.md) is EVERY app online before a save,
  # not just this one; otherwise say so and leave the previous dump alone.
  local bad
  if ! bad="$(pm2_not_online)"; then
    warn "skipping pm2 save: cannot read the pm2 process list ($bad)"; return 0
  fi
  if [ -n "$bad" ]; then
    warn "not every pm2 process is online ($bad) — skipping pm2 save so the dump keeps its last good state. Run \`pm2 save\` yourself once they are."
    return 0
  fi
  pm2_clean save
}

probe() {
  # Local first, then public: a healthy app behind a broken vhost and a dead
  # app behind a fine vhost look identical from the outside, and telling them
  # apart is most of the diagnosis. Both are printed whatever happens.
  #
  # Pass/fail is the LOCAL port answering HTTP at all — any status code,
  # because the vhost may sit behind basic auth and `/` may legitimately not
  # be 200 — retried up to PROBE_TRIES times a second apart, since gunicorn
  # is often still importing the app when pm2 first reports it online. The
  # public side only warns: it also depends on DNS and TLS, which may
  # legitimately not be there yet on a first bring-up.
  local lcode="" pcode i
  for ((i = 1; i <= PROBE_TRIES; i++)); do
    lcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:$PORT/" || true)"
    [ "$lcode" != "000" ] || lcode=""   # curl's code for "never connected"
    [ -z "$lcode" ] || break
    sleep 1
  done
  pcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/" || true)"
  [ "$pcode" != "000" ] || pcode=""
  printf 'local:     http://127.0.0.1:%s/  ->  HTTP %s\n' "$PORT" "${lcode:-unreachable after $PROBE_TRIES tries}"
  printf 'public:    https://%s/  ->  HTTP %s\n' "$FQDN" "${pcode:-unreachable}"
  [ -n "$lcode" ] || return 1
  case "$pcode" in
    ""|5*) warn "app answers locally but https://$FQDN/ is ${pcode:-unreachable} — look at nginx / DNS / TLS, not the app";;
  esac
}

# Playwright's chromium is a versioned download keyed to the installed
# playwright package, so "is it there" is answered by asking playwright where
# it would put it: `install --dry-run` prints an `Install location:` per
# browser it would fetch without fetching anything. Every location present
# -> nothing to do. Unparseable output (older/newer CLI) -> install anyway,
# which is itself a no-op when the browser is already there.
playwright_chromium_present() {
  local out locs loc
  out="$(.venv/bin/playwright install --dry-run chromium 2>/dev/null)" || return 1
  locs="$(printf '%s\n' "$out" | sed -n 's/^[[:space:]]*Install location:[[:space:]]*//p')"
  [ -n "$locs" ] || return 1
  while IFS= read -r loc; do
    [ -d "$loc" ] || return 1
  done <<<"$locs"
}

cmd_deploy() {
  [ $# -eq 0 ] || die "unknown deploy option: $1 (see --help)"
  need_root deploy
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."

  # Decide start-vs-restart BEFORE the sync: a first deploy that cannot start
  # should fail here, not after a hard reset and a pip install it did not need.
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then deploy again."

  local before after
  before="$(git rev-parse --short HEAD)"
  log "Syncing $ROOT to origin/$BRANCH"
  git fetch --quiet origin "$BRANCH"
  git reset --hard --quiet "origin/$BRANCH"
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then log "already current ($after)"
  else log "$before -> $after"; git --no-pager log --oneline "$before..$after"; fi

  # Python side: the venv is gitignored state that survives the reset; create
  # it only when it is missing (first deploy on a fresh clone).
  if [ ! -x .venv/bin/pip ]; then log "python3 -m venv .venv"; python3 -m venv .venv; fi
  log "pip install -r requirements.txt"
  .venv/bin/pip install -q -r requirements.txt

  # Node side (Lighthouse). npm ci, not npm install, when there is a lockfile:
  # the lockfile is the deployed dependency set, and a deploy that silently
  # resolves different versions than CI tested is the bug you find at 2am.
  if [ -f package-lock.json ]; then log "npm ci"; npm ci
  else warn "no package-lock.json — falling back to npm install"; npm install --no-audit --no-fund; fi

  if playwright_chromium_present; then log "playwright chromium already installed"
  else log "playwright install chromium"; .venv/bin/playwright install chromium; fi

  case "$state" in
    "not registered")
      log "pm2 start ${START_CMD[*]}  ($APP, first registration)"
      pm2_clean start "${START_CMD[@]}"
      state="$(pm2_state)" || die "pm2 start ran but the process list is unreadable — $state"
      [ "$state" != "not registered" ] \
        || die "pm2 start ran but nothing named $APP is registered — START_CMD must name it (an ecosystem entry named $APP with --only $APP)."
      ;;
    *)
      log "pm2 restart $APP"
      pm2_clean restart "$APP"
      ;;
  esac
  probe || die "$APP is not answering on 127.0.0.1:$PORT — deploy failed, nothing saved. See: $APP logs"
  save_if_online
  log "deployed: $(git rev-parse --short HEAD)  $(git log -1 --format=%s)"
}

cmd_restart() {
  [ $# -eq 0 ] || die "restart takes no options (see --help)"
  need_root restart
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then retry."
  [ "$state" != "not registered" ] || die "$APP is not registered with pm2 — nothing to restart. First start is: $APP deploy"
  log "pm2 restart $APP"
  pm2_clean restart "$APP"
  probe || die "$APP is not answering on 127.0.0.1:$PORT after restart. See: $APP logs"
}
cmd_logs()    { pm2_clean logs "$APP" "$@"; }

cmd_status() {
  cd "$ROOT"
  printf 'checkout:  %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  printf 'pm2:       %s\n' "$(pm2_state || true)"
  probe || true   # status reports, it does not judge — keep going to the cert
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:      %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:      (run as root to read expiry)\n'
  fi
}

cmd_backup() {
  [ $# -eq 0 ] || die "backup takes no options (see --help)"
  cd "$ROOT"
  local ts out
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p data/backups
  out="data/backups/${APP}-${ts}.tar.gz"
  # WAL-checkpoint the db so the .db file is self-contained, then archive.
  if [ -f data/qa.db ]; then
    .venv/bin/python - <<'PY' || true
import sqlite3, os
if os.path.exists("data/qa.db"):
    c = sqlite3.connect("data/qa.db"); c.execute("PRAGMA wal_checkpoint(TRUNCATE)"); c.close()
PY
  fi
  tar -czf "$out" \
    $( [ -f data/qa.db ] && echo data/qa.db ) \
    $( [ -d data/screenshots ] && echo data/screenshots ) 2>/dev/null || true
  echo "backup -> $out"
}

case "${1:-}" in
  deploy|redeploy) shift; cmd_deploy "$@";;
  restart) shift; cmd_restart "$@";;
  logs)    shift; cmd_logs "$@";;
  status)  shift; cmd_status "$@";;
  backup)  shift; cmd_backup "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
