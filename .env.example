# qa-engine environment. config.py reads this file (<app dir>/.env) itself
# at import time; values already in the process environment take precedence.
# This is the only copy of the key on the droplet: keep the real .env mode 600.
PORT=8044
ANTHROPIC_API_KEY=
# Force mock model responses (also auto-on whenever ANTHROPIC_API_KEY is unset)
MOCK_MODELS=0
# Path to a Chrome/Chromium binary for Lighthouse; blank = auto-detect
CHROME_PATH=
# Uncomment to override crawl budget
#QA_MAX_PAGES=25
#QA_MAX_DEPTH=3
#QA_MAX_TEMPLATES=12
