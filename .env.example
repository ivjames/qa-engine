# qa-engine environment. provision-site seeds PORT= on first provision;
# ANTHROPIC_API_KEY normally comes from /etc/environment on the droplet.
PORT=8044
ANTHROPIC_API_KEY=
# Force mock model responses (also auto-on whenever ANTHROPIC_API_KEY is unset)
MOCK_MODELS=0
# Path to a Chrome/Chromium binary for Lighthouse; blank = auto-detect
CHROME_PATH=
# Uncomment to override crawl budget
#QA_MAX_PAGES=25
#QA_MAX_DEPTH=3
#QA_MAX_TEMPLATES=12
